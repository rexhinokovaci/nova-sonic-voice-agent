{
  "name": "nova-sonic-voice-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Speech-to-speech voice agent on Amazon Nova Sonic: bidirectional streaming, tool use, barge-in, session renewal and per-turn latency tracing.",
  "license": "MIT",
  "author": "Rexhino Kovaci",
  "repository": {
    "type": "git",
    "url": "https://github.com/rexhinokovaci/nova-sonic-voice-agent.git"
  },
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && tsc -p demo/tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "agent": "tsx scripts/run-agent.ts",
    "demo:build": "node demo/build.mjs",
    "demo:serve": "node demo/build.mjs && npx --yes http-server@14.1.1 site -p 8080 -c-1",
    "check": "npm run build && npm run lint && npm run format:check && npm test"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1156.0",
    "@smithy/node-http-handler": "^4.12.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
